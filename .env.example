# Copia este archivo a .env dentro de backend/ (o en la raíz si usas
# docker-compose) y ajusta los valores según tu entorno.

# Servidor
HOST=0.0.0.0
PORT=7860

# Modelo de MusicGen: small | medium | large
MUSICGEN_MODEL=small

# Duración máxima permitida por generación (segundos)
MAX_DURATION_SECONDS=60

# Carpeta donde se guardan los audios generados
OUTPUT_DIR=outputs

# Orígenes permitidos por CORS (coma-separados, o * para todos)
CORS_ORIGINS=*
